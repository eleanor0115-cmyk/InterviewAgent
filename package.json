{
  "name": "interview-agent-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b --force && vite build && tsc -b tsconfig.server.json --force",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.23.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "echarts": "^6.1.0",
    "express": "^4.21.2",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2",
    "tsx": "^4.19.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
